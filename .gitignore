build/bin
node_modules
frontend/dist

# Compiled extension binaries (match common binary names from manifest.json)
extensions/audio/audio
extensions/browser-cdp/browser-cdp
extensions/channel-*/channel-*
extensions/codegraph/codegraph
extensions/composio/composio
extensions/desktop-auto/desktop-auto
extensions/doctor/doctor
extensions/integrations/integrations
extensions/learning-ext/learning-ext
extensions/local-inference/local-inference
extensions/lsp/lsp
extensions/morning-briefing/morning-briefing
extensions/presentation/presentation
extensions/runtime-tools/runtime-tools
extensions/screen-intel/screen-intel
extensions/search-engines/search-engines
extensions/skill-registry/skill-registry
extensions/skill-runtime/skill-runtime
extensions/task-source-*/task-source-*
extensions/tool-*/tool-*
extensions/model-council/model-council

# Local tooling state
.codewhale/

# Wails/npm local install artifacts. The lockfile of record is
# frontend/pnpm-lock.yaml (CI installs with `pnpm install --frozen-lockfile`);
# `wails dev` runs `npm install` locally and would otherwise leave a second,
# competing lockfile in the tree.
frontend/package.json.md5
frontend/package-lock.json

# ZCode agent state
.zcode/

# Built extension artifacts (produced by `go run cmd/build-extensions/main.go`)
extensions-dist/*
!extensions-dist/.gitkeep
extensions/file-state/file-state
extensions/todos/todos
extensions/workflows/workflows
# When you add an extension directory, add its binary here. `go build` inside the
# module names the binary after the directory. Check coverage with:
#   for m in $(find extensions -maxdepth 2 -name go.mod | xargs -n1 dirname); do
#     d=$(basename "$m"); git check-ignore -q "$m/$d" || echo "missing: $m/$d"; done
.DS_Store
